{
  "name": "site-mirror-proxy",
  "version": "1.0.0",
  "description": "Proxy server that mirrors a site and converts absolute URLs to relative",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "sync": "node sync-cache.js",
    "dev:sync": "concurrently \"npm run dev\" \"npm run sync\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "cheerio": "^1.0.0-rc.12"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.0"
  }
}
